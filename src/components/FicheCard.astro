---
interface Props {
	href: string;
	title: string;
	confidenceClass?: string;
	confidenceLabel?: string;
	categoryIcon?: string;
	categoryLabel?: string;
	category?: string;
	accent?: string;
	index?: number;
}

const {
	href,
	title,
	confidenceClass = '',
	confidenceLabel,
	categoryIcon,
	categoryLabel,
	category,
	accent = 'default',
	index = 0,
} = Astro.props;

const delay = `${index * 0.05}s`;
---

<li
	class="sp-fiche-card-wrap sp-animate-in"
	data-accent={accent}
	data-category={category}
	style={`animation-delay: ${delay}`}
>
	<a href={href} class="sp-fiche-card">
		<div class="sp-fiche-card__main">
			<h3>{title}</h3>
			{confidenceLabel && (
				<span class={`sp-badge sp-fiche-card__badge ${confidenceClass}`}>{confidenceLabel}</span>
			)}
		</div>
		{categoryIcon && (
			<span class="sp-fiche-card__cat-icon" title={categoryLabel} aria-hidden="true">
				{categoryIcon}
			</span>
		)}
	</a>
</li>
