---
interface Props {
	href: string;
	title: string;
	confidenceClass?: string;
	confidenceLabel?: string;
	accent?: string;
	index?: number;
}

const {
	href,
	title,
	confidenceClass = '',
	confidenceLabel,
	accent = 'default',
	index = 0,
} = Astro.props;

const delay = `${index * 0.05}s`;
---

<li
	class="sp-fiche-card-wrap sp-animate-in"
	data-accent={accent}
	style={`animation-delay: ${delay}`}
>
	<a href={href} class="sp-fiche-card" data-has-confidence={confidenceLabel ? 'true' : undefined}>
		{confidenceLabel && (
			<span class={`sp-badge sp-fiche-card__badge ${confidenceClass}`}>{confidenceLabel}</span>
		)}
		<h3>{title}</h3>
	</a>
</li>
