---
import type { CategoryId } from '../lib/categories';
import { renderCardTitle } from '../lib/renderCardTitle';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
	href: string;
	title: string;
	cardTitle?: string;
	cardImage?: string;
	cardImageCredit?: string;
	categoryLabel?: string;
	category?: CategoryId;
	accent?: string;
	index?: number;
}

const {
	href,
	title,
	cardTitle,
	cardImage,
	cardImageCredit,
	categoryLabel,
	category,
	accent = 'default',
	index = 0,
} = Astro.props;

const titleHtml = renderCardTitle(cardTitle ?? title);
const delay = `${index * 0.05}s`;
---

<li
	class="sp-fiche-card-wrap sp-animate-in"
	data-accent={accent}
	data-category={category}
	style={`animation-delay: ${delay}`}
>
	<a href={href} class="sp-fiche-card">
		{cardImage && (
			<div class="sp-fiche-card__media" title={cardImageCredit}>
				<img
					src={cardImage}
					alt=""
					width="640"
					height="360"
					loading={index < 4 ? 'eager' : 'lazy'}
					decoding="async"
				/>
			</div>
		)}
		<div class="sp-fiche-card__body">
			<h3 set:html={titleHtml} />
		</div>
		{category && (
			<span class="sp-fiche-card__cat-icon" title={categoryLabel}>
				<CategoryIcon id={category} size={14} />
			</span>
		)}
	</a>
</li>
