---
import type { CategoryId } from '../lib/categories';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
	href: string;
	title: string;
	confidenceClass?: string;
	confidenceLabel?: string;
	categoryLabel?: string;
	category?: CategoryId;
	accent?: string;
	index?: number;
}

const {
	href,
	title,
	confidenceClass = '',
	confidenceLabel,
	categoryLabel,
	category,
	accent = 'default',
	index = 0,
} = Astro.props;

const delay = `${index * 0.05}s`;
---

<li
	class="sp-fiche-card-wrap sp-animate-in"
	data-accent={accent}
	data-category={category}
	style={`animation-delay: ${delay}`}
>
	<a href={href} class="sp-fiche-card">
		<div class="sp-fiche-card__main">
			<h3>{title}</h3>
			{confidenceLabel && (
				<span class={`sp-badge sp-fiche-card__badge ${confidenceClass}`}>{confidenceLabel}</span>
			)}
		</div>
		{category && (
			<span class="sp-fiche-card__cat-icon" title={categoryLabel}>
				<CategoryIcon id={category} size={14} />
			</span>
		)}
	</a>
</li>
