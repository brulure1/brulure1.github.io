---
import FicheCard from './FicheCard.astro';
import { getCatalogFiches, shuffleFiches, toCardProps } from '../lib/ficheCardProps';

const fiches = shuffleFiches(await getCatalogFiches());
const track = [...fiches, ...fiches];
// ~3,5 s par carte — défilement lent (desktop uniquement)
const durationSec = Math.max(48, Math.round(fiches.length * 3.5));
---

<section
	class="sp-fiche-carousel"
	aria-label="Aperçu aléatoire des fiches"
	style={`--sp-carousel-duration: ${durationSec}s`}
>
	<div class="sp-fiche-carousel__fade sp-fiche-carousel__fade--left" aria-hidden="true"></div>
	<div class="sp-fiche-carousel__fade sp-fiche-carousel__fade--right" aria-hidden="true"></div>

	<!-- Mobile / scroll manuel -->
	<div class="sp-fiche-carousel__viewport sp-fiche-carousel__viewport--scroll" tabindex="0">
		<ul class="sp-fiche-carousel__track sp-fiche-carousel__track--scroll">
			{fiches.map((fiche, i) => (
				<FicheCard {...toCardProps(fiche, i)} category={fiche.data.category} />
			))}
		</ul>
	</div>

	<!-- Desktop / défilement auto -->
	<div class="sp-fiche-carousel__viewport sp-fiche-carousel__viewport--auto">
		<ul class="sp-fiche-carousel__track sp-fiche-carousel__track--auto">
			{track.map((fiche, i) => (
				<FicheCard {...toCardProps(fiche, i)} category={fiche.data.category} />
			))}
		</ul>
	</div>
</section>

<style>
	.sp-fiche-carousel {
		position: relative;
		width: 100vw;
		max-width: 100vw;
		margin: 1.25rem calc(50% - 50vw) 1.5rem;
	}

	.sp-fiche-carousel__viewport--scroll {
		display: none;
	}

	.sp-fiche-carousel__viewport--auto {
		overflow: hidden;
	}

	.sp-fiche-carousel__fade {
		position: absolute;
		top: 0;
		bottom: 0;
		width: min(12vw, 7rem);
		z-index: 1;
		pointer-events: none;
	}

	.sp-fiche-carousel__fade--left {
		left: 0;
		background: linear-gradient(
			90deg,
			var(--sl-color-bg) 0%,
			color-mix(in srgb, var(--sl-color-bg) 55%, transparent) 45%,
			transparent 100%
		);
	}

	.sp-fiche-carousel__fade--right {
		right: 0;
		background: linear-gradient(
			270deg,
			var(--sl-color-bg) 0%,
			color-mix(in srgb, var(--sl-color-bg) 55%, transparent) 45%,
			transparent 100%
		);
	}

	.sp-fiche-carousel__track {
		display: flex;
		align-items: stretch;
		gap: 0.875rem;
		width: max-content;
		list-style: none;
		margin: 0;
		padding: 0.125rem 0;
	}

	.sp-fiche-carousel__track--auto {
		animation: sp-carousel-scroll var(--sp-carousel-duration, 90s) linear infinite;
	}

	.sp-fiche-carousel__track--auto:hover {
		animation-play-state: paused;
	}

	.sp-fiche-carousel :global(.sp-fiche-card-wrap) {
		flex: 0 0 22rem;
		width: 22rem;
		animation: none;
		scroll-snap-align: start;
	}

	.sp-fiche-carousel :global(.sp-fiche-card) {
		min-height: 0;
		padding: 0.75rem 2rem 0.75rem 0.9rem;
	}

	.sp-fiche-carousel :global(.sp-fiche-card h3) {
		font-size: 0.9375rem;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.sp-fiche-carousel :global(.sp-fiche-card__cat-icon) {
		top: 0.72rem;
		right: 0.72rem;
		bottom: auto;
	}

	@keyframes sp-carousel-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 49.999rem) {
		.sp-fiche-carousel__fade,
		.sp-fiche-carousel__viewport--auto {
			display: none;
		}

		.sp-fiche-carousel__viewport--scroll {
			display: block;
			overflow-x: auto;
			overflow-y: hidden;
			-webkit-overflow-scrolling: touch;
			overscroll-behavior-x: contain;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: max(1rem, env(safe-area-inset-left));
			touch-action: pan-x;
			scrollbar-width: none;
		}

		.sp-fiche-carousel__viewport--scroll::-webkit-scrollbar {
			display: none;
		}

		.sp-fiche-carousel__track--scroll {
			padding-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right));
		}

		.sp-fiche-carousel :global(.sp-fiche-card-wrap) {
			flex-basis: min(82vw, 20rem);
			width: min(82vw, 20rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sp-fiche-carousel__fade,
		.sp-fiche-carousel__viewport--auto {
			display: none;
		}

		.sp-fiche-carousel__viewport--scroll {
			display: block;
			overflow-x: auto;
			scrollbar-width: thin;
		}

		.sp-fiche-carousel__track--scroll {
			padding-inline: max(1rem, calc(50vw - 50%));
		}
	}
</style>
