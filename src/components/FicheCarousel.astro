---
import FicheCard from './FicheCard.astro';
import { getCatalogFiches, shuffleFiches, toCardProps } from '../lib/ficheCardProps';

const fiches = shuffleFiches(await getCatalogFiches());
const track = [...fiches, ...fiches];
// ~3,5 s par carte — défilement lent
const durationSec = Math.max(48, Math.round(fiches.length * 3.5));
---

<section
	class="sp-fiche-carousel"
	aria-label="Aperçu aléatoire des fiches"
	data-duration={durationSec}
>
	<div class="sp-fiche-carousel__fade sp-fiche-carousel__fade--left" aria-hidden="true"></div>
	<div class="sp-fiche-carousel__fade sp-fiche-carousel__fade--right" aria-hidden="true"></div>

	<div class="sp-fiche-carousel__viewport">
		<ul class="sp-fiche-carousel__track">
			{track.map((fiche, i) => (
				<FicheCard {...toCardProps(fiche, i)} category={fiche.data.category} />
			))}
		</ul>
	</div>
</section>

<script>
	function initCarousel(root: HTMLElement) {
		const viewport = root.querySelector<HTMLElement>('.sp-fiche-carousel__viewport');
		const track = root.querySelector<HTMLElement>('.sp-fiche-carousel__track');
		if (!viewport || !track) return;

		const durationSec = Number(root.dataset.duration) || 90;
		const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

		let paused = motionQuery.matches;
		let resumeTimer: ReturnType<typeof setTimeout> | undefined;
		let lastTime = 0;
		let rafId = 0;

		const loopWidth = () => track.scrollWidth / 2;

		const pause = () => {
			paused = true;
			if (resumeTimer) clearTimeout(resumeTimer);
		};

		const scheduleResume = (delay = 2500) => {
			if (resumeTimer) clearTimeout(resumeTimer);
			if (motionQuery.matches) return;
			resumeTimer = setTimeout(() => {
				paused = false;
				lastTime = 0;
			}, delay);
		};

		const tick = (time: number) => {
			if (!lastTime) lastTime = time;
			const dt = Math.min(time - lastTime, 48);
			lastTime = time;

			const width = loopWidth();
			if (!paused && width > 0) {
				const pxPerMs = width / (durationSec * 1000);
				viewport.scrollLeft += pxPerMs * dt;
				if (viewport.scrollLeft >= width) {
					viewport.scrollLeft -= width;
				}
			}

			rafId = requestAnimationFrame(tick);
		};

		viewport.addEventListener('pointerdown', pause);
		viewport.addEventListener('touchstart', pause, { passive: true });
		viewport.addEventListener('wheel', pause, { passive: true });
		viewport.addEventListener('pointerup', () => scheduleResume());
		viewport.addEventListener('touchend', () => scheduleResume());
		viewport.addEventListener('touchcancel', () => scheduleResume());

		root.addEventListener('pointerenter', pause);
		root.addEventListener('pointerleave', () => scheduleResume(500));

		const onMotionChange = (event: MediaQueryListEvent) => {
			if (event.matches) {
				pause();
			} else {
				scheduleResume(800);
			}
		};
		motionQuery.addEventListener('change', onMotionChange);

		rafId = requestAnimationFrame(tick);

		document.addEventListener('astro:before-swap', () => {
			cancelAnimationFrame(rafId);
			motionQuery.removeEventListener('change', onMotionChange);
		});
	}

	document.querySelectorAll<HTMLElement>('.sp-fiche-carousel').forEach(initCarousel);
</script>

<style>
	.sp-fiche-carousel {
		position: relative;
		width: 100vw;
		max-width: 100vw;
		margin: 1.25rem calc(50% - 50vw) 1.5rem;
	}

	.sp-fiche-carousel__viewport {
		overflow-x: auto;
		overflow-y: hidden;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior-x: contain;
		touch-action: pan-x;
		scrollbar-width: none;
	}

	.sp-fiche-carousel__viewport::-webkit-scrollbar {
		display: none;
	}

	.sp-fiche-carousel__fade {
		position: absolute;
		top: 0;
		bottom: 0;
		width: min(12vw, 7rem);
		z-index: 1;
		pointer-events: none;
	}

	.sp-fiche-carousel__fade--left {
		left: 0;
		background: linear-gradient(
			90deg,
			var(--sl-color-bg) 0%,
			color-mix(in srgb, var(--sl-color-bg) 55%, transparent) 45%,
			transparent 100%
		);
	}

	.sp-fiche-carousel__fade--right {
		right: 0;
		background: linear-gradient(
			270deg,
			var(--sl-color-bg) 0%,
			color-mix(in srgb, var(--sl-color-bg) 55%, transparent) 45%,
			transparent 100%
		);
	}

	.sp-fiche-carousel__track {
		display: flex;
		align-items: stretch;
		gap: 0.875rem;
		width: max-content;
		list-style: none;
		margin: 0;
		padding: 0.125rem 0;
	}

	.sp-fiche-carousel :global(.sp-fiche-card-wrap) {
		flex: 0 0 22rem;
		width: 22rem;
		animation: none;
	}

	.sp-fiche-carousel :global(.sp-fiche-card) {
		min-height: 0;
	}

	.sp-fiche-carousel :global(.sp-fiche-card__body) {
		padding: 0.65rem 0.75rem 0.75rem;
	}

	.sp-fiche-carousel :global(.sp-fiche-card h3) {
		font-size: 0.9375rem;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.sp-fiche-carousel :global(.sp-fiche-card__cat-icon) {
		top: 0.72rem;
		right: 0.72rem;
		bottom: auto;
	}

	@media (max-width: 49.999rem) {
		.sp-fiche-carousel__fade {
			display: none;
		}

		.sp-fiche-carousel__track {
			padding-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right));
		}

		.sp-fiche-carousel :global(.sp-fiche-card-wrap) {
			flex-basis: min(82vw, 20rem);
			width: min(82vw, 20rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sp-fiche-carousel__fade {
			display: none;
		}

		.sp-fiche-carousel__viewport {
			scrollbar-width: thin;
		}

		.sp-fiche-carousel__track {
			padding-inline: max(1rem, calc(50vw - 50%));
		}
	}
</style>
