---
const title = Astro.locals.starlightRoute.entry.data.title;
---

<h1 id="_top">{title}</h1>

<div class="sp-sticky-title" id="sp-sticky-title" aria-hidden="true">
	<span class="sp-sticky-title__text">{title}</span>
</div>

<script>
	function initStickyTitle() {
		const heading = document.getElementById('_top');
		const bar = document.getElementById('sp-sticky-title');
		if (!heading || !bar || bar.dataset.bound === '1') return;
		bar.dataset.bound = '1';

		const navHeight = () => {
			const raw = getComputedStyle(document.documentElement).getPropertyValue('--sl-nav-height');
			return parseFloat(raw) || 56;
		};

		const setVisible = (visible: boolean) => {
			document.documentElement.toggleAttribute('data-sp-sticky-title', visible);
			bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
		};

		const observer = new IntersectionObserver(
			([entry]) => setVisible(!entry.isIntersecting),
			{
				rootMargin: `-${navHeight() + 8}px 0px 0px 0px`,
				threshold: 0,
			},
		);

		observer.observe(heading);
		document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
	}

	document.addEventListener('astro:page-load', initStickyTitle);
	initStickyTitle();
</script>
