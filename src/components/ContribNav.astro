---
const links = [
	{
		href: '/comment-utiliser/',
		label: 'Comment contribuer',
		desc: 'Créer ou mettre à jour une fiche avec Cursor',
		icon: '✍️',
	},
	{
		href: '/methodologie/',
		label: 'Méthodologie',
		desc: 'Sources, niveau de confiance, neutralité',
		icon: '📐',
	},
];
---

<nav class="sp-contrib-nav" aria-label="Contribuer et méthode">
	{
		links.map(({ href, label, desc, icon }) => (
			<a href={href} class="sp-contrib-nav__link">
				<span class="sp-contrib-nav__icon" aria-hidden="true">
					{icon}
				</span>
				<span class="sp-contrib-nav__text">
					<strong>{label}</strong>
					<span>{desc}</span>
				</span>
				<span class="sp-contrib-nav__arrow" aria-hidden="true">
					→
				</span>
			</a>
		))
	}
</nav>

<style>
	.sp-contrib-nav {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 0.75rem;
		margin: 0 0 1.75rem;
	}

	.sp-contrib-nav__link {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.85rem 1rem;
		border-radius: 1rem;
		border: 1px solid var(--sp-border);
		background: var(--sp-surface);
		backdrop-filter: blur(12px);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.2s,
			box-shadow 0.2s;
	}

	.sp-contrib-nav__link:hover {
		border-color: color-mix(in srgb, var(--sp-accent) 45%, transparent);
		box-shadow: 0 8px 24px color-mix(in srgb, var(--sp-accent) 12%, transparent);
	}

	.sp-contrib-nav__icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.625rem;
		background: var(--sl-color-accent-low);
		font-size: 1.1rem;
	}

	.sp-contrib-nav__text {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.sp-contrib-nav__text strong {
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.sp-contrib-nav__text span:last-child {
		font-size: 0.8125rem;
		color: var(--sp-muted);
		line-height: 1.35;
	}

	.sp-contrib-nav__arrow {
		flex-shrink: 0;
		font-weight: 700;
		color: var(--sp-accent);
		opacity: 0.85;
	}
</style>
