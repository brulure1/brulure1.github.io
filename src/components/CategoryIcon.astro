---
import type { CategoryId } from '../lib/categories';
import BriefcaseBusiness from '@lucide/astro/icons/briefcase-business';
import CircleDollarSign from '@lucide/astro/icons/circle-dollar-sign';
import Clapperboard from '@lucide/astro/icons/clapperboard';
import HeartPulse from '@lucide/astro/icons/heart-pulse';
import Microscope from '@lucide/astro/icons/microscope';
import Scale from '@lucide/astro/icons/scale';

interface Props {
	id: CategoryId;
	size?: number;
	class?: string;
}

const { id, size = 16, class: className } = Astro.props;

const ICONS = {
	economie: CircleDollarSign,
	societe: Scale,
	culture: Clapperboard,
	travail: BriefcaseBusiness,
	sante: HeartPulse,
	science: Microscope,
} as const;

const Icon = ICONS[id];
---

{
	Icon && (
		<span class:list={['sp-cat-icon', className]} aria-hidden="true">
			<Icon size={size} stroke-width={2} />
		</span>
	)
}
