---
import { getCollection } from 'astro:content';

const fiches = (await getCollection('docs')).filter(
	(d) => d.data.answerShort && d.data.category && d.data.category !== 'guide' && !d.data.draft,
);
const count = fiches.length;
const categories = new Set(fiches.map((f) => f.data.category)).size;
---

<p class="sp-stats-inline" aria-label="Statistiques du référentiel">
	<span><strong>{count}</strong> fiches</span>
	<span class="sp-stats-inline__sep" aria-hidden="true">·</span>
	<span><strong>{categories}</strong> thèmes</span>
	<span class="sp-stats-inline__sep" aria-hidden="true">·</span>
	<span>100&nbsp;% sourcées</span>
</p>
