---
import { CATEGORIES } from '../lib/categories';
import CategoryIcon from './CategoryIcon.astro';
---

<nav class="sp-cat-nav" aria-label="Filtrer par thème">
	<a href="#sp-fiche-catalog" class="sp-cat-nav__link is-active" data-cat="all" data-cat-label="Toutes les fiches">
		Tous
	</a>
	{
		CATEGORIES.map(({ id, navLabel, label }) => (
			<a href={`#${id}`} class="sp-cat-nav__link" data-cat={id} data-cat-label={label}>
				<CategoryIcon id={id} size={15} />
				{navLabel}
			</a>
		))
	}
</nav>

<script>
	import { CATEGORIES } from '../lib/categories';

	const VALID = new Set(CATEGORIES.map((c) => c.id));
	const CATALOG_ID = 'sp-fiche-catalog';

	function scrollToCatalog() {
		document.getElementById(CATALOG_ID)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}

	function applyFilter(catId: string) {
		const head = document.getElementById('sp-fiche-filter-head');
		const cards = document.querySelectorAll<HTMLElement>('.sp-fiche-card-wrap[data-category]');
		const links = document.querySelectorAll<HTMLAnchorElement>('.sp-cat-nav__link');

		const isAll = !catId || catId === 'all';

		links.forEach((link) => {
			link.classList.toggle('is-active', link.dataset.cat === (isAll ? 'all' : catId));
		});

		if (!head) return;

		if (isAll) {
			head.hidden = true;
			head.removeAttribute('data-accent');
			cards.forEach((card) => {
				card.hidden = false;
			});
			return;
		}

		const activeLink = document.querySelector<HTMLAnchorElement>(`.sp-cat-nav__link[data-cat="${catId}"]`);
		const label = activeLink?.dataset.catLabel ?? catId;
		const iconSource = activeLink?.querySelector('.sp-cat-icon');

		head.hidden = false;
		head.dataset.accent = catId;
		const iconEl = head.querySelector('.sp-fiche-filter-head__icon');
		const labelEl = head.querySelector('.sp-fiche-filter-head__label');
		const countEl = head.querySelector('.sp-fiche-filter-head__count');
		if (iconEl && iconSource) iconEl.innerHTML = iconSource.innerHTML;
		if (labelEl) labelEl.textContent = label;

		let count = 0;
		cards.forEach((card) => {
			const show = card.dataset.category === catId;
			card.hidden = !show;
			if (show) count += 1;
		});
		if (countEl) {
			countEl.textContent = `${count} fiche${count > 1 ? 's' : ''}`;
		}
	}

	function readHash(): string {
		const id = location.hash.slice(1);
		return VALID.has(id as (typeof CATEGORIES)[number]['id']) ? id : 'all';
	}

	function onFilterClick(event: Event) {
		const link = (event.target as Element).closest<HTMLAnchorElement>('.sp-cat-nav__link');
		if (!link) return;
		event.preventDefault();
		const catId = link.dataset.cat ?? 'all';
		applyFilter(catId);
		if (catId !== 'all') {
			history.replaceState(null, '', `#${catId}`);
		} else {
			history.replaceState(null, '', `#${CATALOG_ID}`);
		}
		scrollToCatalog();
	}

	document.querySelector('.sp-cat-nav')?.addEventListener('click', onFilterClick);

	const initial = readHash();
	applyFilter(initial);
	if (initial !== 'all' && location.hash) {
		requestAnimationFrame(() => scrollToCatalog());
	}
	window.addEventListener('hashchange', () => {
		applyFilter(readHash());
		scrollToCatalog();
	});
</script>
