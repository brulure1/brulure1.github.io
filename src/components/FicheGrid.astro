---
import { getCollection } from 'astro:content';
import { CATEGORY_BY_ID } from '../lib/categories';
import FicheCard from './FicheCard.astro';

interface Props {
	limit?: number;
}

const { limit } = Astro.props;

const CONFIDENCE_CLASS: Record<string, string> = {
	elevee: 'sp-badge--high',
	moyenne: 'sp-badge--mid',
	faible: 'sp-badge--low',
	controverse: 'sp-badge--warn',
};

const CONFIDENCE_LABEL: Record<string, string> = {
	elevee: 'Élevée',
	moyenne: 'Moyenne',
	faible: 'Faible',
	controverse: 'Controversé',
};

const docs = await getCollection('docs');

const fiches = docs
	.filter((doc) => doc.data.answerShort && doc.data.category && doc.data.category !== 'guide')
	.filter((doc) => !doc.data.draft)
	.sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr'));

const displayFiches = limit ? fiches.slice(0, limit) : fiches;

const cardProps = (fiche: (typeof fiches)[number], index = 0) => {
	const cat = fiche.data.category ? CATEGORY_BY_ID[fiche.data.category] : undefined;
	return {
		href: `/${fiche.id}/`,
		title: fiche.data.title,
		cardTitle: fiche.data.cardTitle,
		confidenceClass: fiche.data.confidence ? CONFIDENCE_CLASS[fiche.data.confidence] : '',
		confidenceLabel: fiche.data.confidence ? CONFIDENCE_LABEL[fiche.data.confidence] : undefined,
		categoryLabel: cat?.label,
		accent: fiche.data.category ?? 'default',
		index,
	};
};
---

<div class="sp-fiche-grid" id="sp-fiche-catalog">
	<div class="sp-fiche-filter-head" id="sp-fiche-filter-head" hidden>
		<h2>
			<span class="sp-fiche-filter-head__icon sp-section-icon" aria-hidden="true"></span>
			<span class="sp-fiche-filter-head__label"></span>
		</h2>
		<span class="sp-fiche-filter-head__count sp-fiche-section__count"></span>
	</div>
	<ul class="sp-fiche-cards">
		{displayFiches.map((fiche, i) => (
			<FicheCard {...cardProps(fiche, i)} category={fiche.data.category} />
		))}
	</ul>
</div>

<style>
	.sp-fiche-grid {
		margin-top: 1rem;
		scroll-margin-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height, 3rem) + 3.5rem);
	}

	@media (min-width: 50rem) {
		.sp-fiche-grid {
			scroll-margin-top: calc(var(--sl-nav-height) + 4rem);
		}
	}

	.sp-fiche-filter-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.125rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--sp-border);
	}

	.sp-fiche-filter-head[hidden] {
		display: none !important;
	}

	.sp-fiche-filter-head h2 {
		display: flex;
		align-items: center;
		font-size: 1.375rem;
		font-weight: 800;
		margin: 0;
		letter-spacing: -0.03em;
	}

	.sp-fiche-filter-head[data-accent='economie'] h2 {
		color: var(--sp-cat-economie);
	}
	.sp-fiche-filter-head[data-accent='societe'] h2 {
		color: var(--sp-cat-societe);
	}
	.sp-fiche-filter-head[data-accent='travail'] h2 {
		color: var(--sp-cat-travail);
	}
	.sp-fiche-filter-head[data-accent='sante'] h2 {
		color: var(--sp-cat-sante);
	}
	.sp-fiche-filter-head[data-accent='culture'] h2 {
		color: var(--sp-cat-culture);
	}
	.sp-fiche-filter-head[data-accent='science'] h2 {
		color: var(--sp-cat-science);
	}

	.sp-fiche-cards {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		gap: 1.125rem;
	}
</style>
